# Copy this file to .env for local development (never commit the real .env).
# On Render/Railway/Heroku/Vercel, set these as platform environment variables
# instead - do not upload a .env file to those platforms.

# Random long string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Your MongoDB Atlas connection string (Atlas dashboard -> Connect -> Drivers).
# Local example if you're running MongoDB in Docker/locally instead of Atlas:
#   MONGO_URI=mongodb://localhost:27017/DevHost
MONGO_URI=

# Optional organizer bootstrap. No default administrator is created if these are blank.
ADMIN_NAME=Organizer
ADMIN_EMAIL=
# Use a unique password with at least 12 characters.
ADMIN_PASSWORD=

# Code execution requires Docker Desktop and the built isolated runner image.
CODE_EXECUTION_ENABLED=0
RUNNER_IMAGE=hacktoverse-runner:local
